{
  "entities": {
    "Task": {
      "title": "Task",
      "description": "Team tasks assigned to members",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "assignedToId": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "startDate": { "type": "string" },
        "dueDate": { "type": "string" },
        "dueTime": { "type": "string" },
        "category": { "type": "string" },
        "isPrivate": { "type": "boolean" },
        "totalLoggedMinutes": { "type": "number" },
        "isTimerRunning": { "type": "boolean" },
        "completedAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "assignedToId", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Task mentions and assignments notifications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string" },
        "type": { "type": "string" },
        "isRead": { "type": "boolean" },
        "recipientUserId": { "type": "string" }
      },
      "required": ["id", "title", "recipientUserId"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Daily employee attendance, check-in, and check-out records synchronized across all devices",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "memberId": { "type": "string" },
        "memberName": { "type": "string" },
        "employeeCode": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string" },
        "checkInTime": { "type": "string" },
        "checkOutTime": { "type": "string" },
        "lateMinutes": { "type": "number" },
        "isExcused": { "type": "boolean" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "memberId", "date", "status"]
    },
    "Lead": {
      "title": "Lead",
      "description": "Sales leads and prospective clients with assigned representatives and mentions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "company": { "type": "string" },
        "title": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string" },
        "source": { "type": "string" },
        "assignedToId": { "type": "string" },
        "assignedTeamMemberIds": { "type": "array" },
        "mentionedUserIds": { "type": "array" },
        "createdBy": { "type": "string" },
        "creatorName": { "type": "string" },
        "estimatedValue": { "type": "number" },
        "detailedDescription": { "type": "string" },
        "negotiationsHistory": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "company"]
    }
  },
  "firestore": {
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Global tasks collection shared across all team members"
    },
    "/deletedTasks/{taskId}": {
      "schema": "Task",
      "description": "Trash collection of deleted tasks"
    },
    "/notifications/{notifId}": {
      "schema": "Notification",
      "description": "Notifications collection for team members"
    },
    "/teamMembers/{memberId}": {
      "schema": "TeamMember",
      "description": "Team members collection storing credentials, passwords, and profile details"
    },
    "/clientRenewals/{renewalId}": {
      "schema": "ClientRenewal",
      "description": "Client renewals, subscriptions, and assigned team members"
    },
    "/attendance/{attendanceId}": {
      "schema": "Attendance",
      "description": "Real-time employee attendance shifts and check-in status"
    },
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Sales leads assigned to sales representatives or created by them"
    }
  }
}
